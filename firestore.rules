rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin() { return request.auth != null && request.auth.uid == '3m5MqDVbbFTVWl0VNWz1ipKZ8eO2'; }
  function signedIn() { return request.auth != null; }
  function isAssigned(machineId) {
   return signedIn() &&
     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'operator' &&
     machineId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.machineIds;
  }
  function tenantAdmin(tenantId) { return signedIn() && request.auth.uid == tenantId && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tenant_admin' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId; }
  function tenantOperator(tenantId) {
   return signedIn() &&
     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tenant_operator' &&
     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId &&
     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.operatorId is string &&
     exists(/databases/$(database)/documents/businesses/$(tenantId)/operators/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.operatorId)) &&
     get(/databases/$(database)/documents/businesses/$(tenantId)/operators/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.operatorId)).data.active == true &&
     get(/databases/$(database)/documents/businesses/$(tenantId)/operators/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.operatorId)).data.authUid == request.auth.uid;
  }
  function activeTenantAssignment(tenantId, machine) {
    return tenantOperator(tenantId) &&
      machine.get('operatorUid', '') == request.auth.uid &&
      machine.get('operatorId', '') is string &&
      exists(/databases/$(database)/documents/businesses/$(tenantId)/operators/$(machine.operatorId)) &&
      get(/databases/$(database)/documents/businesses/$(tenantId)/operators/$(machine.operatorId)).data.active == true &&
      get(/databases/$(database)/documents/businesses/$(tenantId)/operators/$(machine.operatorId)).data.authUid == request.auth.uid;
  }
  match /businesses/{tenantId} {
   allow create: if signedIn() && request.auth.uid == tenantId && request.resource.data.keys().hasOnly(['name','managerName','ownerUid','createdAt']) && request.resource.data.ownerUid == tenantId && request.resource.data.name is string && request.resource.data.managerName is string && request.resource.data.createdAt == request.time;
   allow read, update: if tenantAdmin(tenantId);
   allow delete: if false;
   // Tenant operators may view only their own assigned machine and job.
   // Their profile must be provisioned by a trusted administrator, never by self-registration.
   match /machines/{machineId} {
    allow read: if tenantAdmin(tenantId) || activeTenantAssignment(tenantId, resource.data);
    allow create, delete: if tenantAdmin(tenantId);
    allow update: if tenantAdmin(tenantId) || (
      activeTenantAssignment(tenantId, resource.data) &&
      resource.data.get('jobReady', false) == true &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','startedAt','elapsedMs','faultReason','jobReady','updatedAt']) &&
      request.resource.data.updatedAt == request.time &&
      request.resource.data.elapsedMs is number &&
      request.resource.data.elapsedMs >= resource.data.get('elapsedMs', 0) &&
      request.resource.data.elapsedMs <= resource.data.get('elapsedMs', 0) + 86400000 &&
      request.resource.data.jobReady == (request.resource.data.status == 'done' ? false : true) &&
      (
       (request.resource.data.status == 'running' &&
        resource.data.status in ['idle','paused','broken'] &&
        request.resource.data.startedAt == request.time &&
        request.resource.data.elapsedMs == resource.data.get('elapsedMs', 0) &&
        request.resource.data.faultReason == '') ||
       (request.resource.data.status in ['paused','broken','done'] &&
        resource.data.status in ['idle','running','paused','broken'] &&
        request.resource.data.startedAt == null &&
        (resource.data.status != 'running' ||
         (resource.data.startedAt is timestamp &&
          request.resource.data.elapsedMs >= resource.data.get('elapsedMs', 0))) &&
        (request.resource.data.status != 'broken' ||
         (request.resource.data.faultReason is string &&
          request.resource.data.faultReason.size() > 0 &&
          request.resource.data.faultReason.size() <= 500)))
      )
    );
   }
   match /jobs/{jobId} {
    allow read: if tenantAdmin(tenantId) || tenantOperator(tenantId) && resource.data.get('operatorUid', '') == request.auth.uid;
    allow create, delete: if tenantAdmin(tenantId);
    allow update: if tenantAdmin(tenantId) || (
      tenantOperator(tenantId) &&
      resource.data.get('operatorUid', '') == request.auth.uid &&
      exists(/databases/$(database)/documents/businesses/$(tenantId)/machines/$(resource.data.machineId)) &&
      activeTenantAssignment(tenantId, get(/databases/$(database)/documents/businesses/$(tenantId)/machines/$(resource.data.machineId)).data) &&
      resource.data.status == 'assigned' &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','finishedAt']) &&
      request.resource.data.status == 'done' &&
      request.resource.data.finishedAt == request.time &&
      getAfter(/databases/$(database)/documents/businesses/$(tenantId)/machines/$(resource.data.machineId)).data.status == 'done' &&
      getAfter(/databases/$(database)/documents/businesses/$(tenantId)/machines/$(resource.data.machineId)).data.jobReady == false &&
      getAfter(/databases/$(database)/documents/businesses/$(tenantId)/machines/$(resource.data.machineId)).data.currentJobId == jobId
    );
   }
   match /customers/{customerId} {
    allow read, write: if tenantAdmin(tenantId);
   }
   match /operators/{operatorId} {
    allow read, write: if tenantAdmin(tenantId);
   }
   match /payments/{paymentId} {
    allow read, write: if tenantAdmin(tenantId);
   }
  }
  match /users/{uid} {
   allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
   allow create: if isAdmin() || (
     signedIn() && request.auth.uid == uid &&
     request.auth.token.email == request.resource.data.email &&
     !request.auth.token.email.matches('.*@operators\\.puantor\\.invalid') &&
     request.resource.data.keys().hasOnly(['role','tenantId','businessName','managerName','email','createdAt']) &&
     request.resource.data.role == 'tenant_admin' &&
     request.resource.data.tenantId == uid &&
     request.resource.data.businessName is string && request.resource.data.businessName.size() >= 2 && request.resource.data.businessName.size() <= 100 &&
     request.resource.data.managerName is string && request.resource.data.managerName.size() >= 2 && request.resource.data.managerName.size() <= 80 &&
     request.resource.data.createdAt == request.time
   ) || (
     signedIn() && request.auth.uid == uid &&
     request.resource.data.keys().hasOnly(['role','tenantId','operatorId','email','active','createdAt']) &&
     request.resource.data.role == 'tenant_operator' &&
     request.resource.data.active == true &&
     request.resource.data.email == request.auth.token.email &&
     request.resource.data.tenantId is string &&
     request.resource.data.operatorId is string &&
     request.resource.data.createdAt == request.time &&
     exists(/databases/$(database)/documents/businesses/$(request.resource.data.tenantId)/operators/$(request.resource.data.operatorId)) &&
     get(/databases/$(database)/documents/businesses/$(request.resource.data.tenantId)/operators/$(request.resource.data.operatorId)).data.authUid == uid &&
     get(/databases/$(database)/documents/businesses/$(request.resource.data.tenantId)/operators/$(request.resource.data.operatorId)).data.active == false &&
     get(/databases/$(database)/documents/businesses/$(request.resource.data.tenantId)/operators/$(request.resource.data.operatorId)).data.authStatus == 'provisioning' &&
     get(/databases/$(database)/documents/businesses/$(request.resource.data.tenantId)/operators/$(request.resource.data.operatorId)).data.email == request.auth.token.email
   ) || (
     signedIn() && request.auth.token.email == request.resource.data.username + "@operators.puantor.invalid" &&
     request.resource.data.keys().hasOnly(["role","username","email","machineIds","createdAt"]) &&
     request.resource.data.role == "pending" &&
     request.resource.data.email == request.auth.token.email &&
     request.resource.data.machineIds == [] &&
     request.resource.data.createdAt == request.time &&
     request.auth.uid == uid &&
     getAfter(/databases/$(database)/documents/operators/$(request.resource.data.username)).data.pendingUid == uid
   );
   allow update: if isAdmin() || (
     signedIn() && request.auth.uid == uid &&
     resource.data.role == 'operator' &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeMachineId']) &&
     request.resource.data.activeMachineId is string &&
     (
       (
         request.resource.data.activeMachineId != '' &&
         resource.data.get('activeMachineId', '') == '' &&
         request.resource.data.activeMachineId in resource.data.machineIds &&
         getAfter(/databases/$(database)/documents/machines/$(request.resource.data.activeMachineId)).data.operatorUid == uid &&
         getAfter(/databases/$(database)/documents/machines/$(request.resource.data.activeMachineId)).data.status == 'running'
       ) ||
       (
         request.resource.data.activeMachineId == '' &&
         resource.data.get('activeMachineId', '') != '' &&
         getAfter(/databases/$(database)/documents/machines/$(resource.data.activeMachineId)).data.status != 'running'
       )
     )
   );
   allow delete: if isAdmin();
  }
  match /searchPreferences/{uid} {
   allow read: if isAdmin() && request.auth.uid == uid;
   allow create, update: if isAdmin() && request.auth.uid == uid &&
     request.resource.data.keys().hasOnly(['preferences','updatedAt']) &&
     request.resource.data.preferences is map &&
     request.resource.data.preferences.size() <= 250 &&
     request.resource.data.updatedAt == request.time;
   allow delete: if isAdmin() && request.auth.uid == uid;
  }
  match /customers/{customerId} {
   allow read, write: if isAdmin();
  }
  match /operators/{operatorId} {
   allow read: if isAdmin();
   allow create, delete: if isAdmin();
   allow update: if isAdmin() || (
     signedIn() &&
     request.auth.token.email == operatorId + "@operators.puantor.invalid" &&
     resource.data.authStatus == "pending" &&
     !("pendingUid" in resource.data) &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pendingUid","updatedAt"]) &&
     request.resource.data.pendingUid == request.auth.uid &&
     request.resource.data.updatedAt == request.time &&
     getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "pending" &&
     getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == operatorId
   );
  }
  match /machines/{machineId} {
   allow read: if isAdmin() || isAssigned(machineId);
   allow create, delete: if isAdmin();
   // Assigned operators can change runtime state only, never machine ownership.
   allow update: if isAdmin() || (
     isAssigned(machineId) &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly([
       'status','startedAt','elapsedMs','faultReason','jobReady','updatedAt','timeline'
     ]) &&
     request.resource.data.updatedAt == request.time &&
     request.resource.data.timeline is list &&
     request.resource.data.timeline.size() <= 250 &&
     request.resource.data.timeline.size() == resource.data.get('timeline', []).size() + 1 &&
     request.resource.data.timeline[request.resource.data.timeline.size() - 1].action in ['start','pause','fault','finish'] &&
     request.resource.data.elapsedMs is number &&
     request.resource.data.elapsedMs >= resource.data.elapsedMs &&
     request.resource.data.elapsedMs >= 0 &&
     // Only the manager may authorize a new job; operators may only revoke authorization on finish.
     resource.data.get('jobReady', false) == true &&
     request.resource.data.jobReady == (request.resource.data.status == 'done' ? false : true) &&
     (
       (request.resource.data.status == 'running' &&
        resource.data.status in ['idle','paused','broken'] &&
        request.resource.data.startedAt == request.time &&
        request.resource.data.elapsedMs == resource.data.elapsedMs &&
        request.resource.data.faultReason == '' &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeMachineId == machineId) ||
       (request.resource.data.status in ['paused','broken','done'] &&
        resource.data.status in ['idle','running','paused','broken'] &&
        request.resource.data.startedAt == null &&
        (resource.data.status != 'running' ||
         (resource.data.startedAt is timestamp &&
          request.resource.data.elapsedMs >= resource.data.elapsedMs)) &&
        (request.resource.data.status != 'broken' ||
         (request.resource.data.faultReason is string &&
          request.resource.data.faultReason.size() > 0 &&
          request.resource.data.faultReason.size() <= 500)))
     )
   );
  }
  match /jobs/{jobId} {
   allow read: if isAdmin() || (signedIn() && resource.data.operatorUid == request.auth.uid);
   allow create: if isAdmin() || (signedIn() && request.resource.data.operatorUid == request.auth.uid);
   allow update, delete: if isAdmin();
  }
  match /payments/{paymentId} {
   allow read: if isAdmin();
   allow create: if isAdmin() &&
     request.resource.data.keys().hasAll(['customerName','amount','date','note','createdAt']) &&
     request.resource.data.keys().hasOnly(['customerName','amount','date','note','createdAt']) &&
     request.resource.data.customerName is string && request.resource.data.customerName.size() > 0 &&
     request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 100000000 &&
     request.resource.data.date is string && request.resource.data.date.size() == 10 &&
     request.resource.data.note is string && request.resource.data.note.size() <= 150 &&
     request.resource.data.createdAt == request.time;
   allow update: if isAdmin() &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date','amount','note']) &&
     request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 100000000 &&
     request.resource.data.date is string && request.resource.data.date.size() == 10 &&
     request.resource.data.note is string && request.resource.data.note.size() <= 150;
   allow delete: if isAdmin();
  }
  match /{document=**} { allow read, write: if false; }
 }
}