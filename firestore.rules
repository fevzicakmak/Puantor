// Runtime state and operator activeMachineId are written only by operatorWorkState.
// Payment fields: customerName string, amount positive number (TRY), date YYYY-MM-DD,
// note string <=150, createdAt timestamp (immutable; historical backup restores allowed).
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Server-owned deletion receipts immediately block old, still-valid tokens.
  // Pending/processing requests keep normal access. No client can write receipts.
  function signedIn() {
   return request.auth != null &&
     (!exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid)) ||
      !(get(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid)).data.status in ['deleting','completed']));
  }
  function isAdmin() { return signedIn() && request.auth.uid == '3m5MqDVbbFTVWl0VNWz1ipKZ8eO2'; }
  function businessOpen(tenantId) {
   return exists(/databases/$(database)/documents/businesses/$(tenantId)) &&
     get(/databases/$(database)/documents/businesses/$(tenantId)).data.get('accountStatus', 'active') != 'closed';
  }
  function isAssigned(machineId) {
   return signedIn() &&
     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'operator' &&
     machineId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.machineIds;
  }
  function tenantAdmin(tenantId) { return signedIn() && request.auth.uid == tenantId && businessOpen(tenantId) && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tenant_admin' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId; }
  function tenantOperator(tenantId) {
   return signedIn() && businessOpen(tenantId) &&
     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tenant_operator' &&
     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId;
  }
  function tenantMachineAssigned(tenantId, machineId) {
   return tenantOperator(tenantId) &&
     machineId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.machineIds &&
     resource.data.operatorUid == request.auth.uid;
  }
  match /businesses/{tenantId} {
   allow create: if signedIn() && request.auth.uid == tenantId && request.resource.data.keys().hasOnly(['name','managerName','ownerUid','createdAt']) && request.resource.data.ownerUid == tenantId && request.resource.data.name is string && request.resource.data.managerName is string && request.resource.data.createdAt == request.time;
   allow read: if tenantAdmin(tenantId);
   // The owner and original creation timestamp must remain immutable.
   allow update: if tenantAdmin(tenantId) &&
     request.resource.data.ownerUid == resource.data.ownerUid &&
     resource.data.ownerUid == tenantId &&
     request.resource.data.createdAt == resource.data.createdAt &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','managerName']) &&
     request.resource.data.name is string &&
     request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100 &&
     request.resource.data.managerName is string &&
     request.resource.data.managerName.size() >= 2 && request.resource.data.managerName.size() <= 80;
   allow delete: if false;
   match /{subcollection}/{recordId} {
    allow read, write: if tenantAdmin(tenantId) && subcollection in ['machines','customers','operators','jobs','searchPreferences'];
    // Operators can only read machines assigned to them, never other tenant records.
    allow get: if subcollection == 'machines' && tenantMachineAssigned(tenantId, recordId);
    // Operator state changes go through the authenticated callable function.

   }
  }
  function validPayment(data) {
   return data.keys().hasAll(['customerName','amount','date','note','createdAt']) &&
     data.keys().hasOnly(['customerId','customerName','amount','date','note','createdAt']) &&
     (!('customerId' in data) || (data.customerId is string && data.customerId.size() > 0 && data.customerId.size() <= 128)) &&
     data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 500 &&
     data.amount is number && data.amount > 0 && data.amount <= 100000000 &&
     data.date is string && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
     data.note is string && data.note.size() <= 150 &&
     data.createdAt is timestamp && data.createdAt <= request.time;
  }
  match /businesses/{tenantId}/payments/{paymentId} {
   allow read, delete: if tenantAdmin(tenantId);
   allow create: if tenantAdmin(tenantId) && validPayment(request.resource.data);
   allow update: if tenantAdmin(tenantId) && validPayment(request.resource.data) &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date','amount','note']) &&
     request.resource.data.createdAt == resource.data.createdAt;
  }
  function tenantManagerForUser(data) {
   return signedIn() && data.get('tenantId', '') is string &&
     data.get('tenantId', '') == request.auth.uid &&
     tenantAdmin(request.auth.uid) &&
     data.get('role', '') in ['tenant_operator_pending', 'tenant_operator'];
  }
  match /users/{uid} {
   allow read: if isAdmin() || (signedIn() && request.auth.uid == uid) || tenantManagerForUser(resource.data);
   allow create: if isAdmin() || (
     signedIn() && request.auth.uid == uid &&
     request.auth.token.email == request.resource.data.email &&
     !request.auth.token.email.matches('.*@operators\\.puantor\\.invalid') &&
     request.resource.data.keys().hasOnly(['role','tenantId','businessName','managerName','email','createdAt']) &&
     request.resource.data.role == 'tenant_admin' &&
     request.resource.data.tenantId == uid &&
     request.resource.data.businessName is string && request.resource.data.businessName.size() >= 2 && request.resource.data.businessName.size() <= 100 &&
     request.resource.data.managerName is string && request.resource.data.managerName.size() >= 2 && request.resource.data.managerName.size() <= 80 &&
     request.resource.data.createdAt == request.time
   ) || (
     signedIn() && request.auth.token.email == request.resource.data.username + "@operators.puantor.invalid" &&
     request.resource.data.keys().hasOnly(["role","username","email","machineIds","createdAt"]) &&
     request.resource.data.role == "pending" &&
     request.resource.data.email == request.auth.token.email &&
     request.resource.data.machineIds == [] &&
     request.resource.data.createdAt == request.time &&
     request.auth.uid == uid &&
     getAfter(/databases/$(database)/documents/operators/$(request.resource.data.username)).data.pendingUid == uid
   );
   allow update: if isAdmin() || (
     tenantManagerForUser(resource.data) &&
     request.resource.data.get('tenantId', '') == resource.data.tenantId &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','displayName','machineIds','updatedAt']) &&
     request.resource.data.get('role', '') in ['tenant_operator_pending','tenant_operator'] &&
     (resource.data.role == 'tenant_operator' || request.resource.data.role == 'tenant_operator') &&
     request.resource.data.get('machineIds', []) is list &&
     request.resource.data.get('machineIds', []).size() <= 100 &&
     request.resource.data.updatedAt == request.time
   );
   allow delete: if isAdmin();
  }
  match /searchPreferences/{uid} {
   allow read: if isAdmin() && request.auth.uid == uid;
   allow create, update: if isAdmin() && request.auth.uid == uid &&
     request.resource.data.keys().hasOnly(['preferences','updatedAt']) &&
     request.resource.data.preferences is map &&
     request.resource.data.preferences.size() <= 250 &&
     request.resource.data.updatedAt == request.time;
   allow delete: if isAdmin() && request.auth.uid == uid;
  }
  match /customers/{customerId} {
   allow read, write: if isAdmin();
  }
  match /operators/{operatorId} {
   allow read: if isAdmin();
   allow create, delete: if isAdmin();
   allow update: if isAdmin() || (
     signedIn() &&
     request.auth.token.email == operatorId + "@operators.puantor.invalid" &&
     resource.data.authStatus == "pending" &&
     !("pendingUid" in resource.data) &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pendingUid","updatedAt"]) &&
     request.resource.data.pendingUid == request.auth.uid &&
     request.resource.data.updatedAt == request.time &&
     getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "pending" &&
     getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == operatorId
   );
  }
  match /machines/{machineId} {
   allow read: if isAdmin() || isAssigned(machineId);
   allow create, delete: if isAdmin();
   // Operators cannot replace elapsedMs or timeline directly.
   allow update: if isAdmin();
  }
  match /jobs/{jobId} {
   allow read: if isAdmin() || (signedIn() && resource.data.operatorUid == request.auth.uid);
   allow create: if isAdmin();
   allow update, delete: if isAdmin();
  }
  match /payments/{paymentId} {
   allow read: if isAdmin();
   allow create: if isAdmin() && validPayment(request.resource.data);
   allow update: if isAdmin() && validPayment(request.resource.data) &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date','amount','note']) &&
     request.resource.data.createdAt == resource.data.createdAt;
   allow delete: if isAdmin();
  }
  match /{document=**} { allow read, write: if false; }
 }
}
