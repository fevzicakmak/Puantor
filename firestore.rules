rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin() { return request.auth != null && request.auth.uid == '3m5MqDVbbFTVWl0VNWz1ipKZ8eO2'; }
  function signedIn() { return request.auth != null; }
  function isAssigned(machineId) {
   return signedIn() &&
     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'operator' &&
     machineId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.machineIds;
  }
  function invitePath(code) { return /databases/$(database)/documents/operators/$(code); }
  function validInvite(code) {
    return signedIn() && code is string && code.size() == 32 &&
      exists(invitePath(code)) &&
      get(invitePath(code)).data.authStatus == "pending";
  }
  match /users/{uid} {
   allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
   allow create: if isAdmin() || (
     signedIn() && request.auth.uid == uid &&
     request.resource.data.keys().hasOnly(["role","email","username","displayName","machineIds","inviteCode","createdAt"]) &&
     validInvite(request.resource.data.inviteCode) &&
     request.resource.data.role == "operator" &&
     request.resource.data.email == request.auth.token.email &&
     request.resource.data.username == get(invitePath(request.resource.data.inviteCode)).data.username &&
     request.resource.data.displayName == get(invitePath(request.resource.data.inviteCode)).data.displayName &&
     request.resource.data.machineIds == [] &&
     request.resource.data.createdAt == request.time &&
     getAfter(invitePath(request.resource.data.inviteCode)).data.authUid == uid &&
     getAfter(invitePath(request.resource.data.inviteCode)).data.authStatus == "active"
   );
   allow update, delete: if isAdmin();
  }
  match /customers/{customerId} {
   allow read, write: if isAdmin();
  }
  match /operators/{operatorId} {
   allow read: if isAdmin() || (signedIn() && operatorId.size() == 32);
   allow create, delete: if isAdmin();
   allow update: if isAdmin() || (
     signedIn() && operatorId.size() == 32 &&
     resource.data.authStatus == "pending" &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(["authUid","authStatus","updatedAt"]) &&
     request.resource.data.authUid == request.auth.uid &&
     request.resource.data.authStatus == "active" &&
     request.resource.data.updatedAt == request.time &&
     getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.inviteCode == operatorId &&
     getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "operator"
   );
  }
  match /machines/{machineId} {
   allow read: if isAdmin() || isAssigned(machineId);
   allow create, delete: if isAdmin();
   // Assigned operators can change runtime state only, never machine ownership.
   allow update: if isAdmin() || (
     isAssigned(machineId) &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly([
       'status','startedAt','elapsedMs','faultReason','jobReady','updatedAt'
     ]) &&
     request.resource.data.updatedAt == request.time &&
     request.resource.data.elapsedMs is number &&
     request.resource.data.elapsedMs >= resource.data.elapsedMs &&
     request.resource.data.elapsedMs >= 0 &&
     // Only the manager may authorize a new job; operators may only revoke authorization on finish.
     resource.data.get('jobReady', false) == true &&
     request.resource.data.jobReady == (request.resource.data.status == 'done' ? false : true) &&
     (
       (request.resource.data.status == 'running' &&
        resource.data.status in ['idle','paused','broken'] &&
        request.resource.data.startedAt == request.time &&
        request.resource.data.elapsedMs == resource.data.elapsedMs &&
        request.resource.data.faultReason == '') ||
       (request.resource.data.status in ['paused','broken','done'] &&
        resource.data.status in ['idle','running','paused','broken'] &&
        request.resource.data.startedAt == null &&
        (resource.data.status != 'running' ||
         (resource.data.startedAt is timestamp &&
          request.resource.data.elapsedMs >= resource.data.elapsedMs)) &&
        (request.resource.data.status != 'broken' ||
         (request.resource.data.faultReason is string &&
          request.resource.data.faultReason.size() > 0 &&
          request.resource.data.faultReason.size() <= 500)))
     )
   );
  }
  match /jobs/{jobId} {
   allow read: if isAdmin() || (signedIn() && resource.data.operatorUid == request.auth.uid);
   allow create: if isAdmin() || (signedIn() && request.resource.data.operatorUid == request.auth.uid);
   allow update, delete: if isAdmin();
  }
  match /{document=**} { allow read, write: if false; }
 }
}